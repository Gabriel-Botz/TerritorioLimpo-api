# Copie para .env e preencha. Nunca versionar valores reais.

# Servidor
PORT=8080

# Banco de dados (Supabase Postgres em produção; Postgres local em dev)
DB_URL=jdbc:postgresql://localhost:5432/territorio_limpo
DB_USER=postgres
DB_PASSWORD=postgres

# Supabase Storage (bucket privado)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=occurrence-photos

# Supabase Auth (JWT do painel administrativo)
# Use JWKS (chaves assimétricas) ou o segredo HS256 legado. Pelo menos um é obrigatório em prod.
SUPABASE_JWKS_URI=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_ISSUER=

# Claim de administrador dentro de app_metadata
ADMIN_ROLE_CLAIM=app_role
ADMIN_ROLE_VALUE=ADMIN

# CORS (lista separada por vírgula, sem curinga em produção)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Cloudflare Turnstile (opcional)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_IP_LIMIT=5
RATE_LIMIT_PER_IP_WINDOW=1h
RATE_LIMIT_GLOBAL_LIMIT=100
RATE_LIMIT_GLOBAL_WINDOW=1h
RATE_LIMIT_IP_HEADER=X-Forwarded-For
